# The targeted public-model launcher verifies this existing local image first.
FROM guanye-worker:latest
USER root
WORKDIR /app
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir 'transformers==5.20.2' 'accelerate==1.15.0' 'faiss-cpu==1.15.1' 'timm==1.0.30' einops iopath ftfy regex huggingface-hub==2.2.0
COPY model_service model_service
COPY worker worker
COPY integrations/telemetry.py telemetry.py
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
USER 10001
CMD ["uvicorn","model_service.server:app","--host","0.0.0.0","--port","8082"]
